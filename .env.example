# Copy to .env for local use. On a host, set these as environment variables instead.
PORT=3000
NODE_ENV=development

# Free Postgres connection string from neon.tech (Dashboard -> Connect -> copy the string)
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Set to false only if you use a Postgres on your own computer
# DATABASE_SSL=false

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
# Comma-separated emails that get the Placement Officer (admin) role on login
ADMIN_EMAILS=you@example.com
# Only needed if the frontend is hosted on a DIFFERENT domain than the backend
# CORS_ORIGIN=https://your-frontend.netlify.app
